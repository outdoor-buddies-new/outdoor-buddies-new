generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // for local development
  // url      = env("postgres://fa9221ceaf2f0068ee1738f8c609f680eba846a248e43dd259a5a9d3de70da7e:sk_vNE6eMPZGSOaKbAZCuaUm@db.prisma.io:5432/postgres?sslmode=require")
  // for Vercel
  url       = env("postgres://fa9221ceaf2f0068ee1738f8c609f680eba846a248e43dd259a5a9d3de70da7e:sk_vNE6eMPZGSOaKbAZCuaUm@db.prisma.io:5432/postgres?sslmode=require")
  directUrl = env("postgres://fa9221ceaf2f0068ee1738f8c609f680eba846a248e43dd259a5a9d3de70da7e:sk_vNE6eMPZGSOaKbAZCuaUm@db.prisma.io:5432/postgres?sslmode=require")
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}
